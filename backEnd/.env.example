# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database — local (dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=portfolio_db

# Database — production (Supabase ou autre)
# Si DATABASE_URL est défini, les vars DB_* ci-dessus sont ignorées
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# JWT — OBLIGATOIRE en production : utiliser une valeur longue et aléatoire
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# CORS — URL du frontend (Vercel en production)
FRONTEND_URL=http://localhost:3000

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads