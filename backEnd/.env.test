# Dummy values for running the test suite without a real .env file.
# Not real credentials — loaded by jest.setup.js before each test run.
NODE_ENV=test
PORT=5000
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=test
DB_PASSWORD=test
DB_DATABASE=test

JWT_SECRET=test-jwt-secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
